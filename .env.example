# Local PostgreSQL container. Change the sample password in your local .env file.
POSTGRES_DB=fivondronana
POSTGRES_USER=fivondronana
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432

# Local API container. For a physical phone, set API_BIND_ADDRESS to the host's LAN IP
# and use that same IP in EXPO_PUBLIC_API_URL. Keep PostgreSQL bound to loopback.
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=5106
API_PORT=5106
API_BODY_LIMIT=100kb
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
# In production, set a comma-separated HTTPS origin allowlist.
CORS_ALLOWED_ORIGINS=

# Prisma on the host connects through localhost; the API container uses the Compose service name.
DATABASE_URL=postgresql://fivondronana:local_dev_only_change_me@localhost:5432/fivondronana?schema=public
DATABASE_URL_DOCKER=postgresql://fivondronana:local_dev_only_change_me@postgres:5432/fivondronana?schema=public

# Generate a private random value (at least 32 characters) for API access tokens.
# Do not use a shared or committed value for JWT_SECRET.
JWT_SECRET=

# SendGrid is required for administrator-created account activation emails.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Vite's development server listens on the explicit port in BACKOFFICE_URL (default: 5173).
BACKOFFICE_URL=http://localhost:5173

# Mobile API endpoint
EXPO_PUBLIC_API_URL=http://localhost:5106/api
APP_ENV=development
NODE_ENV=development

# Optional: both private local values, read only by the development demo seed
# (bun run db:seed:demo). Set both to create a local administrator for backoffice
# login; leave both blank to skip. Never used in production.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Separate ephemeral PostgreSQL test service; never shares the development volume.
# `bun run test:integration` starts and stops this container automatically.
POSTGRES_TEST_PORT=55434
# Password and URL are generated uniquely by scripts/test-integration.ts per run.

# Arisiva file uploads fail closed if ClamAV cannot be reached.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_HOST_PORT=3310
