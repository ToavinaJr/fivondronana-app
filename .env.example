# Local PostgreSQL container. Change the sample password in your local .env file.
POSTGRES_DB=fivondronana
POSTGRES_USER=fivondronana
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432

# Local API container. For a physical phone, set API_BIND_ADDRESS to the host's LAN IP
# and use that same IP in EXPO_PUBLIC_API_URL. Keep PostgreSQL bound to loopback.
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=3000
API_PORT=3000

# Prisma on the host connects through localhost; the API container uses the Compose service name.
DATABASE_URL=postgresql://fivondronana:local_dev_only_change_me@localhost:5432/fivondronana?schema=public
DATABASE_URL_DOCKER=postgresql://fivondronana:local_dev_only_change_me@postgres:5432/fivondronana?schema=public

# Mobile API endpoint
EXPO_PUBLIC_API_URL=http://localhost:3000/api
