{
  "name": "@fivondronana/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start:dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun dist/main.js",
    "build": "bun run db:generate && tsc -p tsconfig.build.json",
    "typecheck": "bun run db:generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test": "bun test",
    "test:integration": "bun test --timeout 30000 tests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:bootstrap-admin": "bun --env-file=../../.env run scripts/bootstrap-admin.ts",
    "db:seed:demo": "bun --env-file=../../.env run scripts/seed-demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.0",
    "prisma": "^7.10.0",
    "typescript": "~5.9.3"
  }
}
