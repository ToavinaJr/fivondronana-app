generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  accountName  String
  email        String?       @unique
  emailNormalized String?    @unique
  phone        String?       @unique
  phoneNormalized String?    @unique
  passwordHash String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
  cv           Cv?
  membership   EntityMembership?
  roles        UserRole[]
  responsibilities UserResponsibility[]
}

enum Role {
  ADMINISTRATOR
  RESPONSIBLE
  ENTITY_MANAGER
  GENERAL_MANAGER
}

model Entity {
  id          String             @id @default(cuid())
  name        String             @unique
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  groups      Group[]
  memberships EntityMembership[]
}

model Group {
  id          String             @id @default(cuid())
  name        String
  entityId    String
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  entity      Entity             @relation(fields: [entityId], references: [id], onDelete: Restrict)
  memberships EntityMembership[]

  @@unique([id, entityId])
  @@unique([entityId, name])
  @@index([entityId, isActive])
}

model EntityMembership {
  id        String   @id @default(cuid())
  userId    String   @unique
  entityId  String
  groupId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Restrict)
  group     Group    @relation(fields: [groupId, entityId], references: [id, entityId], onDelete: Restrict)

  @@index([entityId])
  @@index([groupId])
}

model UserRole {
  userId    String
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role, userId])
}

model OfficialResponsibility {
  id          String               @id @default(cuid())
  name        String               @unique
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  assignments UserResponsibility[]
}

model UserResponsibility {
  userId           String
  responsibilityId String
  createdAt        DateTime               @default(now())
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  responsibility  OfficialResponsibility @relation(fields: [responsibilityId], references: [id], onDelete: Restrict)

  @@id([userId, responsibilityId])
  @@index([responsibilityId])
}

model AuthSession {
  id        String    @id
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum ContactKind {
  INTERNAL
  EXTERNAL
}

model Contact {
  id             String      @id @default(cuid())
  name           String
  responsibility String
  groupLabel     String
  address        String
  phone          String
  email          String
  description    String
  kind           ContactKind
  isPublished    Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([isPublished, name])
}

model Cv {
  id            String      @id @default(cuid())
  userId        String      @unique
  firstName     String
  lastName      String
  address       String
  birthDate     DateTime
  birthPlace    String?
  phone         String
  email         String
  facebook      String?
  province      String
  area          String
  fivondronana  String
  extraPersonal String[]    @default([])
  extraContact  String[]    @default([])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branches      CvBranch[]
  activities    CvActivity[]
}

model CvBranch {
  id        String   @id @default(cuid())
  cvId      String
  name      String
  group     String
  project   String?
  startedAt DateTime?
  endedAt   DateTime?
  cv        Cv       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  @@index([cvId])
}

model CvActivity {
  id          String   @id @default(cuid())
  cvId        String
  name        String?
  responsibility String?
  description String?
  date        DateTime?
  cv          Cv       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  @@index([cvId])
}

model FileObject {
  storageKey String   @id
  data       Bytes
  size       Int
  sha256     String
  createdAt  DateTime @default(now())
  archive    Archive?
}

model Archive {
  id          String     @id @default(cuid())
  title       String
  description String     @default("")
  category    String
  year        Int?
  fileName    String
  contentType String
  size        Int
  sha256      String
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  storageKey  String     @unique
  file        FileObject @relation(fields: [storageKey], references: [storageKey], onDelete: Restrict)

  @@index([isPublished, category, year, title])
}
