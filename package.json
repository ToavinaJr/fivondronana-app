{
  "name": "fivondronana-platform",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @fivondronana/api start:dev",
    "dev:mobile": "bun run --filter @fivondronana/mobile start",
    "dev:api": "bun run --filter @fivondronana/api start:dev",
    "build:api": "bun run --filter @fivondronana/api build",
    "typecheck": "bun run --filter '*' typecheck",
    "db:generate": "bun run --filter @fivondronana/api db:generate",
    "db:migrate": "bun run --filter @fivondronana/api db:migrate",
    "db:deploy": "bun run --filter @fivondronana/api db:deploy"
  }
}
